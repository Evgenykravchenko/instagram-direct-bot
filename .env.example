NODE_ENV=development
LOG_LEVEL=debug

# Meta / Instagram Login
INSTAGRAM_ACCESS_TOKEN=replace-with-long-lived-access-token
INSTAGRAM_ACCOUNT_ID=123456789012345
INSTAGRAM_APP_SECRET=replace-with-meta-app-secret
INSTAGRAM_VERIFY_TOKEN=replace-with-random-webhook-token
META_GRAPH_VERSION=v23.0

# Shared content platform
CONTENT_BOT_KEY=instagram-direct-bot
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=replace-with-directus-service-token
CONTENT_CACHE_TTL_SECONDS=60
YANDEX_DISK_TOKEN=replace-with-yandex-oauth-token
MEDIA_POLL_INTERVAL_SECONDS=20
MEDIA_BATCH_SIZE=3

# Durable webhook queue
DATABASE_URL=postgresql://instagram_direct:instagram_direct@localhost:5434/instagram_direct
DATABASE_SSL=false
EVENT_POLL_INTERVAL_MS=500
EVENT_MAX_ATTEMPTS=8
EVENT_LOCK_TIMEOUT_SECONDS=300

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8091
WEBHOOK_PATH=/webhook
WEBHOOK_BODY_LIMIT_BYTES=1048576
