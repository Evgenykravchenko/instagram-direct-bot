BOT_VERSION=0.1.0
BOT_IMAGE=ghcr.io/evgenykravchenko/instagram-direct-bot
NODE_ENV=production
LOG_LEVEL=info
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
